# ctf.helli-10th-computer.ir -> CTFd container (published port 8000 on host)
server {
    listen      80;
    listen [::]:80;
    server_name ctf.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ctf.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/helli-10th-computer.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/helli-10th-computer.ir/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 8m;

    # websocket support (CTFd live scoreboard updates)
    location / {
        proxy_pass http://62.3.41.38:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;

        # serve the Helli logo instead of CTFd's default on the homepage
        # (server-side rewrite — works regardless of browser JS/cache)
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '/themes/core/static/img/logo.png' '/files/assets/helli-logo.png';
        sub_filter '/files//files/' '/files/';
    }
}
