# Copy to panel.env and edit before: docker compose up -d --build
# Flask session signing key (generate a random one)
STUDENTCTL_SECRET=__GENERATE_A_RANDOM_SECRET__

# Where the panel reaches the Linux playground over SSH.
# If the playground is THIS host, use:  host.docker.internal
STUDENTCTL_SSH_HOST=10.0.0.10
STUDENTCTL_SSH_PORT=22
STUDENTCTL_SSH_USER=studentctl
STUDENTCTL_SSH_KEY=/var/lib/studentctl/panel_key

# Public address students use to SSH in / reach their service
STUDENTCTL_SERVER_DOMAIN=10.0.0.10
STUDENTCTL_SSH_PORT_PUBLIC=22

# SQLite path (inside the container; backed by the panel-data volume)
STUDENTCTL_DB=/var/lib/studentctl/panel.db

# Access caps (also editable from the admin UI)
STUDENTCTL_MAX_CONCURRENT=30
STUDENTCTL_IDLE_TIMEOUT=1800

# Seed admin (CHANGE THE PASSWORD immediately after first login)
STUDENTCTL_ADMIN_USER=admin
STUDENTCTL_ADMIN_PASS=changeme123

# Grading hub -> CTFd score sync (public URL + admin API token)
CTFD_URL=https://ctf.example.ir
CTFD_TOKEN=ctfd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
